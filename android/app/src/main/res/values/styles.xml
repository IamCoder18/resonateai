<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Brand colors shared by status bar + system navigation bar. -->
    <color name="brand_canvas">#0a0907</color>
    <color name="brand_accent">#7a3818</color>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:statusBarColor">@color/brand_accent</item>
        <item name="android:navigationBarColor">@color/brand_canvas</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:statusBarColor">@color/brand_accent</item>
        <item name="android:navigationBarColor">@color/brand_canvas</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!-- Pre-API-31 splash: this layer-list is what Android shows while the activity is starting. -->
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:statusBarColor">@color/brand_accent</item>
        <item name="android:navigationBarColor">@color/brand_canvas</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- Android 12+ SplashScreen API: canvas + the same brand mark as the launcher icon. -->
        <item name="android:windowSplashScreenBackground">@color/brand_canvas</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
    </style>
</resources>
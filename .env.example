# Generated by setup
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-48
BETTER_AUTH_URL=https://resonate.aaravlabs.com
PUBLIC_BASE_URL=https://resonate.aaravlabs.com

POSTGRES_USER=resonate
POSTGRES_PASSWORD=replace-with-strong-random-password
POSTGRES_DB=resonate

# Garage S3 — credentials are auto-generated by the `garage-init` container on
# first boot and written to the shared `garage_shared` volume. The web container
# picks them up at startup via /shared/garage.env. No host-side values needed.

# SMTP (Mailjet example)
SMTP_HOST=in-v3.mailjet.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-mailjet-api-key
SMTP_PASS=your-mailjet-secret-key
SMTP_FROM="Resonate AI <resonateai.customer@yourdomain.com>"

# Where upload-notification emails are sent (the "To" address).
NOTIFY_EMAIL=resonateai.orders@yourdomain.com

# Admin's email — REQUIRED. The admin has access to every signed download link
# regardless of which email it was minted for. Also used to gate /api/admin/* and
# the admin dashboard. The app refuses to start if this is missing or invalid.
ADMIN_EMAIL=admin@example.com